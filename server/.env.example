PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# Neon PostgreSQL Connection URL (replace with your Neon pooled connection string)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
