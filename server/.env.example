# Server port
PORT=5000

# PostgreSQL connection string (PostgreSQL is required outside tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/offlinebridge

# Secret key for signing JWT tokens
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Set true only for local tests without PostgreSQL
USE_MOCK_DB=false

# Environment
NODE_ENV=development
