{
  "name": "offlinebridge-server",
  "version": "1.0.0",
  "description": "Backend API server for OfflineBridge rural digital government services",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/migrations/migrate.js",
    "db:seed": "node src/migrations/seed.js",
    "db:reset": "node src/migrations/reset.js",
