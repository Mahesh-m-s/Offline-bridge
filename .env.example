# ==============================================================================
# OfflineBridge (ArivuNet) — Unified Docker Environment Configuration
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Compose Project
COMPOSE_PROJECT_NAME=offlinebridge

# Host Port Mappings
FRONTEND_PORT=5173
BACKEND_PORT=5000
DB_PORT=5432

# PostgreSQL Database Credentials
POSTGRES_DB=offlinebridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend API Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=offlinebridge_super_secure_jwt_secret_key_rural_services_2026
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Database Connection (Container networking: uses postgres service hostname)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/offlinebridge
DB_HOST=postgres
DB_PORT=5432
DB_NAME=offlinebridge
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Optional: Gemini AI Configuration (for RAG assistant features)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Frontend Build Arguments
VITE_API_BASE_URL=http://localhost:5000

